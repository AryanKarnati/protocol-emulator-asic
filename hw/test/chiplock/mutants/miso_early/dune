; Chip mutant: MISO one bit early (chip.md 6.5). The model shows the bit of the next shift.
(rule
 (targets chip.ml)
 (deps ../../../../../sw/pgsim/chip.ml)
 (action
  (run %{exe:../../../mutants/tool/mutate.exe} ../../../../../sw/pgsim/chip.ml chip.ml
   "  let miso = (t.miso_sr lsr 31) land 1 in" "  let miso = (t.miso_sr lsr 30) land 1 in")))

(rule
 (targets chip.mli)
 (deps ../../../../../sw/pgsim/chip.mli)
 (action
  (copy ../../../../../sw/pgsim/chip.mli chip.mli)))

(library
 (name pgsim_mut_chip_miso_early)
 (modules chip)
 (flags (:standard -w -69))
 (libraries polyglot_pgsim))
