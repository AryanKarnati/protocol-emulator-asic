[tasks]
# Unbounded k-induction (see PROPERTIES.md for the depth reached, if any).
prove
# Bounded: 120 cycles reaches the first write word and the first read commit. The cover task runs to 184 cycles: free pins toggle SCK every 2 cycles, and the second write word (bit 87) needs about 180 cycles.
bmc
# Reachability of the covers in hostlink_harness.v.
cover

[options]
prove: mode prove
prove: depth 8
bmc: mode bmc
bmc: depth 72
cover: mode cover
cover: depth 184

[engines]
smtbmc boolector

[script]
read_verilog -formal hostlink.v
read_verilog -formal hostlink_harness.v
prep -top hostlink_harness

[files]
build/hostlink.v
hostlink_harness.v
