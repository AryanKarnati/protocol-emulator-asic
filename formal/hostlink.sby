[tasks]
# Unbounded k-induction (see PROPERTIES.md for the depth reached, if any).
prove
# Bounded: 96 cycles covers two words in a frame and a second frame.
bmc
# Reachability of the covers in hostlink_harness.v.
cover

[options]
prove: mode prove
prove: depth 8
bmc: mode bmc
bmc: depth 96
cover: mode cover
cover: depth 96

[engines]
smtbmc z3

[script]
read_verilog -formal hostlink.v
read_verilog -formal hostlink_harness.v
prep -top hostlink_harness

[files]
build/hostlink.v
hostlink_harness.v
