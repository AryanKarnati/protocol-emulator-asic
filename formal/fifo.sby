[tasks]
flags_prove
cover_all

[options]
flags_prove: mode prove
flags_prove: depth 4
cover_all: mode cover
cover_all: depth 20

[engines]
flags_prove: smtbmc z3
cover_all: smtbmc z3

[script]
flags_prove: read_verilog -formal fifo_harness.v
cover_all: read_verilog -formal -DTOKEN fifo_harness.v
read_verilog -formal fifo_4x32.v
prep -top fifo_harness

[files]
build/fifo_4x32.v
fifo_harness.v
