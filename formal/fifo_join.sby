[tasks]
flags_prove
token_bmc
cover_all

[options]
flags_prove: mode prove
flags_prove: depth 4
token_bmc: mode bmc
token_bmc: depth 20
cover_all: mode cover
cover_all: depth 20

[engines]
flags_prove: smtbmc boolector
token_bmc: abc bmc3
cover_all: smtbmc boolector

[script]
flags_prove: read_verilog -formal fifo_join_harness.v
token_bmc: read_verilog -formal -DTOKEN fifo_join_harness.v
cover_all: read_verilog -formal -DTOKEN fifo_join_harness.v
read_verilog -formal fifo_join.v
prep -top fifo_join_harness

[files]
build/fifo_join.v
fifo_join_harness.v
