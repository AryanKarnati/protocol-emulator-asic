[tasks]
prove
prove_b1
cover

[options]
prove: mode prove
prove: depth 2
prove_b1: mode prove
prove_b1: depth 2
cover: mode cover
cover: depth 40

[engines]
smtbmc z3

[script]
prove: read_verilog -formal clkdiv_dbg.v
prove_b1: read_verilog -formal clkdiv_dbg_b1.v
cover: read_verilog -formal clkdiv_dbg.v
prove: read_verilog -formal clkdiv_dbg_harness.v
prove_b1: read_verilog -formal clkdiv_dbg_harness.v
cover: read_verilog -formal clkdiv_dbg_harness.v
prove: prep -top clkdiv_dbg_harness
prove_b1: prep -top clkdiv_dbg_harness
cover: prep -top clkdiv_dbg_harness

[files]
build/clkdiv_dbg.v
build/clkdiv_dbg_b1.v
clkdiv_dbg_harness.v
